---
import BaseLayout from '../layouts/BaseLayout.astro';
import Search from 'astro-pagefind/components/Search.astro';
---

<BaseLayout title="검색 · 씨유" description="글을 검색합니다." active="search" narrow>
  <h1 class="page-heading" id="search-heading">글 검색</h1>
  <div class="search-page">
    <Search
      instance="site-search"
      className="pagefind-neutral"
      searchboxOptions={{ placeholder: '글 본문에서 검색' }}
      configOptions={{ lang: 'ko' }}
    />
  </div>
</BaseLayout>

<style>.search-page{padding-bottom:48px;min-height:360px}</style>

<script>
  // Pagefind recreates its input when translations load; preserve its accessible name.
  const searchbox = document.querySelector('pagefind-searchbox');
  if (searchbox) {
    const labelInput = () => {
      searchbox.querySelector('input')?.setAttribute('aria-labelledby', 'search-heading');
    };
    labelInput();
    new MutationObserver(labelInput).observe(searchbox, { childList: true, subtree: true });
  }
</script>
