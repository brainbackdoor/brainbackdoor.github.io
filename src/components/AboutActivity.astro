---
import type { Project } from '../data/about';
import { renderInline } from '../lib/inline';

interface Props {
  activity: Project;
}
const { activity } = Astro.props;
---

<article class="about-entry project-entry">
  <div class="entry-heading">
    <h3>{activity.title}</h3>
    <div class="entry-date">
      {activity.org} · {activity.period}
    </div>
  </div>

  {
    activity.bullets.length > 0 && (
      <ul class="about-bullets">
        {activity.bullets.map((b) => (
          <li set:html={renderInline(b)} />
        ))}
      </ul>
    )
  }

  {
    activity.subProjects && activity.subProjects.length > 0 && (
      <div class="sub-entry">
        {activity.subProjects.map((sp) => (
          <div class="project-subentry">
            <div class="entry-heading">
              <h4 class="text-[14.5px] font-semibold tracking-[-0.01em]">{sp.title}</h4>
              {sp.period && (
                <div class="entry-date">{sp.period}</div>
              )}
            </div>
            <ul class="about-bullets">
              {sp.bullets.map((b) => (
                <li set:html={renderInline(b)} />
              ))}
            </ul>
          </div>
        ))}
      </div>
    )
  }
</article>
