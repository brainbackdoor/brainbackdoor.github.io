---
import CategoryFilter, { type FilterablePost } from './CategoryFilter';
import { loadPosts } from '../lib/collection';
import { formatShortDate, getYear } from '../lib/date';

interface Props {
  lang: string;
}
const { lang } = Astro.props;

const posts = await loadPosts(lang);

const items: FilterablePost[] = posts.map((p) => ({
  title: p.title,
  category: p.category,
  href: p.href,
  year: getYear(p.pubDate),
  meta: `${formatShortDate(p.pubDate)} · ${p.minutes}분`,
}));

const firstYear = posts.length
  ? getYear(posts[posts.length - 1].pubDate)
  : String(new Date().getUTCFullYear());
---

<section class="pt-16 pb-10">
  <div class="mb-4.5 text-xs font-semibold tracking-[0.16em] text-ink-faint uppercase">
    아카이브
  </div>
  <h1 class="m-0 text-[30px] leading-[1.15] font-extrabold tracking-[-0.03em] sm:text-[44px] sm:leading-[1.12]">
    기록의 목차
  </h1>
  <p class="mt-4 text-[17px] leading-relaxed text-ink-muted">
    {firstYear}년부터 남긴 {posts.length}편의 글. 카테고리로 골라 보거나, 아래에서
    연도별로 훑어보세요.
  </p>
</section>

<CategoryFilter posts={items} client:load />
