---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostArticle from '../../components/PostArticle.astro';
import { loadEntries, toSummary } from '../../lib/collection';
import { parseEntryId } from '../../lib/posts';

export async function getStaticPaths() {
  const entries = await loadEntries('ko');
  return entries.map((entry) => ({
    params: { slug: parseEntryId(entry.id).slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const post = toSummary(entry);
---

<BaseLayout title={`${post.title} · 씨유`} description={post.description} active="archive">
  <PostArticle entry={entry} lang="ko" />
</BaseLayout>
