---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutActivity from '../components/AboutActivity.astro';
import { renderInline } from '../lib/inline';
import {
  profile,
  career,
  projects,
  values,
  education,
  certifications,
  contact,
  sns,
  externalActivities,
} from '../data/about';
---

<BaseLayout
  title="소개 · 이동규"
  description="이동규 — 소프트웨어 엔지니어 · brainbackdoor"
  active="about"
>
  <div class="profile-layout">
    <div class="profile-content">
      <!-- 소개 -->
      <section
        id="intro"
        class="about-intro"
      >
        <img
          src="/me.webp"
          alt="이동규"
          width="104"
          height="104"
          class="about-portrait"
        />
        <div>
          <div class="section-label">자기소개</div>
          <h1 class="about-name">
            {profile.name}
          </h1>
          <p class="about-role">{profile.role}</p>
          <p
            class="about-intro-copy"
            set:html={renderInline(profile.intro)}
          />
        </div>
      </section>

      <!-- 경력 -->
      <section id="career" class="about-section">
        <h2 class="section-label">경력</h2>
        <div class="about-entries">
          {
            career.map((c) => (
              <article class="about-entry">
                <div class="entry-heading">
                  <h3>{c.org}</h3>
                  <div class="entry-date">{c.period}</div>
                </div>
                <div class="entry-team">
                  {c.team} · {c.role}
                </div>
                <ul class="about-bullets">
                  {c.bullets.map((b) => (
                    <li set:html={renderInline(b)} />
                  ))}
                </ul>
                {c.groups?.map((g) => (
                  <div class="sub-entry">
                    <div class="entry-label">{g.label}</div>
                    <ul class="about-bullets">
                      {g.items.map((it) => (
                        <li set:html={renderInline(it)} />
                      ))}
                    </ul>
                  </div>
                ))}
              </article>
            ))
          }
        </div>
      </section>

      <!-- 프로젝트 -->
      <section id="projects" class="about-section">
        <h2 class="section-label">프로젝트</h2>
        <div class="about-entries">
          {projects.map((p) => <AboutActivity activity={p} />)}
        </div>
      </section>

      <!-- 지향하는 개발 문화 -->
      <section id="culture" class="about-section">
        <h2 class="section-label">지향하는 개발 문화</h2>
        <div class="about-entries">
          {
            values.map((v) => (
              <article class="about-entry">
                <h3
                  class="text-[18px] font-bold tracking-[-0.02em] text-accent [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2"
                  set:html={renderInline(v.name)}
                />
                <div class="culture-tagline">{v.tagline}</div>
                <ul class="about-bullets">
                  {v.body.map((p) => (
                    <li set:html={renderInline(p)} />
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <!-- 대외활동 (카드) -->
      <section id="activity" class="about-section">
        <h2 class="section-label">대외활동</h2>
        <div class="activity-grid">
          {
            externalActivities.map((a) => {
              const Tag = a.href ? 'a' : 'div';
              return (
                <Tag
                  href={a.href}
                  target={a.href ? '_blank' : undefined}
                  rel={a.href ? 'noopener' : undefined}
                  class="activity-card"
                >
                  <div class="activity-image">
                    {a.image && (
                      <img src={a.image} alt={a.title} loading="lazy" />
                    )}
                  </div>
                  <div class="activity-body">
                    <div class="text-[14px] font-semibold tracking-[-0.01em] group-hover:text-accent">
                      {a.title}
                    </div>
                  </div>
                </Tag>
              );
            })
          }
        </div>
      </section>

      <!-- 학력 / 자격증 / 연락 (하단) -->
      <section class="about-bottom">
        <div>
          <h2 class="section-label">Education</h2>
          <ul class="credential-list">
            {
              education.map((e) => (
                <li>
                  <div class="text-[15px] font-semibold tracking-[-0.01em]">{e.school}</div>
                  <div class="mt-0.5 text-[13px] text-ink-subtle">
                    {e.detail} · {e.status}
                  </div>
                  <div class="text-[12px] text-ink-faint tabular-nums">{e.period}</div>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2 class="section-label">자격증</h2>
          <ul class="credential-list">
            {
              certifications.map((c) => (
                <li>
                  <div class="text-[15px] font-semibold tracking-[-0.01em]">{c.name}</div>
                  <div class="mt-0.5 text-[13px] text-ink-subtle">
                    {c.issuer} · {c.date}
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2 class="section-label">Contact</h2>
          <a
            href={`mailto:${contact}`}
            class="mt-5 inline-block text-[15px] text-accent transition-colors hover:text-accent-hover"
          >
            {contact}
          </a>
          <div class="about-sns">
            {
              sns.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="me noopener"
                  class="text-[13.5px] font-medium text-ink-muted transition-colors hover:text-accent"
                >
                  {s.label}
                </a>
              ))
            }
          </div>
        </div>
      </section>
    </div>

    <!-- 좁은 화면에서는 본문 폭을 확보하고 모든 정보는 펼친 채 유지한다. -->
    <aside class="profile-toc">
      <nav aria-label="목차">
        <p class="section-label">목차</p>
        <ul class="toc-list">
          <li><a data-toc href="#intro" class="toc-link">소개</a></li>
          <li><a data-toc href="#career" class="toc-link">경력</a></li>
          <li><a data-toc href="#projects" class="toc-link">프로젝트</a></li>
          <li><a data-toc href="#culture" class="toc-link">개발 문화</a></li>
          <li><a data-toc href="#activity" class="toc-link">대외활동</a></li>
        </ul>
      </nav>
    </aside>
  </div>

  <style is:global>
    .profile-layout { display:grid;grid-template-columns:minmax(0,1fr) 118px;gap:26px;align-items:start; }
    .profile-content { min-width:0; }
    .profile-content p, .profile-content li { overflow-wrap:anywhere;word-break:normal; }
    .profile-content strong { color:var(--color-ink);font-weight:600; }
    .profile-content .text-accent { color:var(--color-accent);text-decoration:underline;text-underline-offset:3px;text-decoration-color:#afc5e8; }
    .profile-content a:hover { color:var(--color-accent); }
    .profile-content .section-label { font-size:14px;font-weight:600;letter-spacing:.035em;color:var(--color-ink-muted); }
    .profile-content .about-intro { display:flex;align-items:flex-start;gap:26px;padding:12px 0 42px;border-bottom:1px solid var(--color-border);scroll-margin-top:32px; }
    .profile-content .about-portrait { width:104px;height:104px;object-fit:cover;flex-shrink:0;border-radius:50%;border:1px solid #e2e7ee; }
    .profile-content .about-name { margin:11px 0 7px;font-size:42px;font-weight:700;line-height:1.12;letter-spacing:-1.6px; }
    .profile-content .about-role { font-size:15px;color:var(--color-ink-muted); }
    .profile-content .about-intro-copy { margin-top:23px;font-size:15px;line-height:1.85;color:var(--color-ink-muted); }
    .profile-content .about-section { padding:43px 0 20px;border-bottom:1px solid var(--color-border);scroll-margin-top:32px; }
    .profile-content .about-entries { margin-top:16px; }
    .profile-content .about-entry { padding:25px 0;border-top:1px solid var(--color-border); }
    .profile-content .about-entry:first-child { border-top:0;padding-top:12px; }
    .profile-content .entry-heading { display:flex;flex-wrap:wrap;justify-content:space-between;gap:5px 18px;align-items:baseline; }
    .profile-content .entry-heading h3, .profile-content .about-entry>h3 { font-size:18px;line-height:1.55;letter-spacing:-.3px;font-weight:600; }
    .profile-content .entry-date { font-size:14px;line-height:1.7;color:var(--color-ink-muted);font-variant-numeric:tabular-nums; }
    .profile-content .entry-team { margin-top:3px;font-size:14px;color:var(--color-ink-muted);line-height:1.8; }
    .profile-content .about-bullets { display:flex;flex-direction:column;gap:8px;padding-left:20px;margin:15px 0 0;font-size:15px;line-height:1.85;color:var(--color-ink-muted);list-style:disc; }
    .profile-content .about-bullets li::marker { font-size:.8em;color:#7c8c9d; }
    .profile-content .sub-entry { margin-top:21px;padding-left:17px;border-left:1px solid var(--color-border); }
    .profile-content .sub-entry h4, .profile-content .entry-label { font-size:15px;line-height:1.8;font-weight:600;margin:0; }
    .profile-content .sub-entry .about-bullets { margin-top:9px;font-size:14px;line-height:1.9; }
    .profile-content .project-subentry+.project-subentry { margin-top:24px; }
    .profile-content .culture-tagline { font-size:14px;color:var(--color-ink-muted);line-height:1.85;margin-top:7px; }
    .profile-content .activity-grid { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:25px 0; }
    .profile-content .activity-card { display:block;min-width:0;border:1px solid var(--color-border);border-radius:10px;overflow:hidden;transition:border-color .15s; }
    .profile-content .activity-card:hover { border-color:#8caee2; }
    .profile-content .activity-image { aspect-ratio:16/10;background:#f3f5f8; }
    .profile-content .activity-image img { width:100%;height:100%;object-fit:cover;display:block; }
    .profile-content .activity-body { padding:14px;font-size:14px;font-weight:600;line-height:1.7;word-break:keep-all;overflow-wrap:anywhere; }
    .profile-content .activity-body>div { font:inherit; }
    .profile-content .about-bottom { display:grid;grid-template-columns:1fr 1fr 1.25fr;gap:32px 24px;padding:43px 0; }
    .profile-content .credential-list { list-style:none;margin:19px 0 0;padding:0;display:flex;flex-direction:column;gap:19px; }
    .profile-content .about-bottom>div>a { margin-top:18px;font-size:15px;overflow-wrap:anywhere; }
    .profile-content .about-sns { display:flex;flex-wrap:wrap;gap:9px 22px;margin-top:17px; }
    .profile-content .about-sns a { font-size:14px;color:var(--color-ink-muted); }
    .profile-toc { position:sticky;top:48px;padding-top:14px; }
    .profile-toc .section-label { color:var(--color-ink-muted);font-size:14px;font-weight:500; }
    .profile-toc ul { list-style:none;padding:0;margin:15px 0 0; }
    .profile-toc a { display:block;border-left:1.5px solid var(--color-border);padding:7px 0 7px 13px;font-size:14px;line-height:1.6;color:var(--color-ink-muted); }
    .profile-toc a:hover { color:var(--color-accent); }
    .profile-toc a[aria-current='true'] { color:var(--color-accent);border-left-color:var(--color-accent);font-weight:600; }
    @media(max-width:1100px) {
      .profile-layout { display:block; }
      .profile-toc { display:none; }
    }
    @media(max-width:850px) {
      .profile-content .about-bottom { grid-template-columns:1fr 1fr; }
      .profile-content .about-bottom>div:last-child { grid-column:1/-1; }
      .profile-content .activity-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    }
    @media(max-width:600px) {
      .profile-content .about-intro { padding:0 0 32px;gap:22px;flex-direction:column; }
      .profile-content .about-portrait { width:88px;height:88px; }
      .profile-content .about-name { font-size:36px;margin:11px 0 8px; }
      .profile-content .about-intro-copy { line-height:1.9;margin-top:20px; }
      .profile-content .about-section { padding:34px 0 10px;scroll-margin-top:18px; }
      .profile-content .about-entry { padding:24px 0; }
      .profile-content .entry-heading { display:block; }
      .profile-content .entry-heading .entry-date { margin-top:4px; }
      .profile-content .entry-team { margin-top:7px; }
      .profile-content .about-bullets { line-height:1.9;gap:10px; }
      .profile-content .sub-entry { padding-left:14px; }
      .profile-content .activity-grid { grid-template-columns:1fr;gap:18px;margin:24px 0; }
      .profile-content .activity-body { font-size:15px;padding:14px 16px; }
      .profile-content .about-bottom { grid-template-columns:1fr;gap:32px;padding:34px 0; }
    }
  </style>

  <script>
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.profile-toc [data-toc]')];
    const sections = links.map((link) => document.getElementById(link.hash.slice(1))).filter((section): section is HTMLElement => section !== null);
    const updateProfileToc = () => {
      let active = sections[0]?.id;
      for (const section of sections) {
        if (section.getBoundingClientRect().top > 140) break;
        active = section.id;
      }
      for (const link of links) link.setAttribute('aria-current', String(link.hash === `#${active}`));
    };
    updateProfileToc();
    window.addEventListener('scroll', updateProfileToc, { passive: true });
    window.addEventListener('resize', updateProfileToc, { passive: true });
    document.fonts.ready.then(updateProfileToc);
  </script>
</BaseLayout>
