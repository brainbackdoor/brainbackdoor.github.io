---
import type { TopicSection } from '../data/infra';
interface Props { section: TopicSection; }
const { section } = Astro.props;
---

<section id={section.id} class="resource-group" data-resource-group={section.id} aria-labelledby={`resource-title-${section.id}`}>
  <h3 id={`resource-title-${section.id}`}>{section.title}</h3>
  <ul class="resource-items">
    {section.items.map((item) => (
      <li data-resource-item data-search={`${section.title} ${item.label}`}>
        <a href={item.href}><span>{item.label}</span>{item.href.startsWith('https://') && <span class="resource-external" aria-hidden="true">↗</span>}</a>
      </li>
    ))}
  </ul>
</section>

<style>
  .resource-group { display: grid; grid-template-columns: 148px minmax(0, 1fr); gap: 26px; padding: 24px 0; border-bottom: 1px solid var(--color-border); scroll-margin-top: 32px; }
  .resource-group h3 { margin: 0; padding-top: 3px; font-size: 14px; font-weight: 600; line-height: 1.6; }
  .resource-items { display: flex; flex-direction: column; gap: 15px; margin: 0; padding: 0; list-style: none; }
  .resource-items a { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; font-size: 14px; font-weight: 500; letter-spacing: -.2px; line-height: 1.65; word-break: keep-all; overflow-wrap: anywhere; }
  .resource-items a:hover > span:first-child { text-decoration: underline; text-underline-offset: 4px; }
  .resource-external { flex-shrink: 0; padding-top: 1px; color: var(--color-ink-muted); font-size: 13px; font-weight: 400; }
  @media (max-width: 950px) { .resource-group { grid-template-columns: 120px minmax(0, 1fr); gap: 20px; } }
  @media (max-width: 600px) {
    .resource-group { display: block; padding: 22px 0; }
    .resource-group h3 { margin-bottom: 15px; font-size: 13px; }
    .resource-items { gap: 17px; }
  }
</style>
