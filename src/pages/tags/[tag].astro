---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadPosts } from '../../lib/collection';
import { collectTags, postsWithTag } from '../../lib/posts';
import { categoryLabel } from '../../lib/categories';
import { formatShortDate } from '../../lib/date';

export async function getStaticPaths() {
  const posts = await loadPosts('ko');
  return collectTags(posts).map((t) => ({
    params: { tag: t.tag },
    props: { posts: postsWithTag(posts, t.tag) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`#${tag} · 씨유`} description={`${tag} 태그가 붙은 글.`} narrow>
  <section class="pt-16 pb-8">
    <a href="/tags" class="text-[13px] text-ink-faint transition-colors hover:text-ink-subtle">
      ← 태그 목록
    </a>
    <h1 class="mt-6 mb-0 text-[30px] leading-[1.15] font-extrabold tracking-[-0.03em] sm:text-[44px] sm:leading-[1.12]">
      #{tag}
    </h1>
    <p class="mt-3 text-[15px] text-ink-muted">{posts.length}편</p>
  </section>

  <div class="pb-18">
    {
      posts.map((p) => (
        <a
          href={p.href}
          class="flex flex-col gap-1 border-t border-ink/8 py-4 transition-opacity hover:opacity-60 sm:grid sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-5"
        >
          <div class="flex flex-wrap items-baseline gap-3">
            <span class="text-[10.5px] font-semibold tracking-[0.06em] text-accent uppercase sm:min-w-16">
              {categoryLabel(p.category)}
            </span>
            <span class="text-[17px] font-semibold tracking-[-0.01em]">{p.title}</span>
          </div>
          <span class="font-mono text-[12.5px] whitespace-nowrap text-ink-faint">
            {formatShortDate(p.pubDate)} · {p.minutes}분
          </span>
        </a>
      ))
    }
  </div>
</BaseLayout>
