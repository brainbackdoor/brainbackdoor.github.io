---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;

// 디자인의 목차는 한 층이다. h2만 노출한다.
const items = headings.filter((h) => h.depth === 2);

/*
 * 활성/비활성 클래스를 겹쳐 쓰지 않고 통째로 교체한다.
 * text-ink와 text-ink-subtle은 명시도가 같아서, 둘을 동시에 걸면 승자가
 * Tailwind가 CSS를 뽑는 순서에 달린다. 실제로 그 순서는 비활성 쪽이 뒤라
 * 활성 클래스를 더해도 아무 일도 일어나지 않았다.
 *
 * 스크립트는 프런트매터 변수를 볼 수 없으므로 data 속성으로 넘긴다.
 * 클래스 목록의 출처를 여기 하나로 두기 위해서다.
 */
const LINK_BASE = '-ml-0.5 border-l-2 py-1.5 pl-4 text-[13px] leading-snug transition-all';
const LINK_ON = 'border-accent text-ink';
const LINK_OFF = 'border-transparent text-ink-subtle hover:border-accent hover:text-ink';
---

{
  items.length > 0 && (
    <aside class="hidden lg:sticky lg:top-20 lg:block lg:pt-14 lg:pb-10">
      <div class="mb-4 text-[11px] font-semibold tracking-[0.14em] text-ink-subtle uppercase">
        목차
      </div>
      <nav
        class="flex flex-col gap-0.5 border-l-2 border-ink/10"
        data-toc-nav
        data-on={LINK_ON}
        data-off={LINK_OFF}
      >
        {items.map((h) => (
          <a href={`#${h.slug}`} data-toc-link={h.slug} class={`${LINK_BASE} ${LINK_OFF}`}>
            {h.text}
          </a>
        ))}
      </nav>
    </aside>
  )
}

<script>
  const nav = document.querySelector<HTMLElement>('[data-toc-nav]');
  const headings = [...document.querySelectorAll<HTMLElement>('.prose h2[id]')];

  if (nav && headings.length > 0) {
    const on = (nav.dataset.on ?? '').split(' ').filter(Boolean);
    const off = (nav.dataset.off ?? '').split(' ').filter(Boolean);
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];

    // 헤더에 가린 영역은 읽는 중이 아니다. .prose h2의 scroll-margin-top과 같은 값.
    const HEADER_OFFSET = 80;

    const setActive = (slug: string | null) => {
      for (const link of links) {
        const active = link.dataset.tocLink === slug;
        link.classList.remove(...(active ? off : on));
        link.classList.add(...(active ? on : off));
      }
    };

    /*
     * 지금 읽는 절 = 화면 위쪽 띠를 이미 지나간 마지막 제목. 아직 아무 제목도
     * 지나가지 않았으면(도입부) 활성 항목이 없다.
     *
     * IntersectionObserver를 쓰지 않는다. 관찰자는 "교차 상태가 바뀐 제목"만
     * 알려줘서 상태를 따로 쌓아둬야 하고, 그 상태는 두 방향으로 낡는다.
     * 위로 스크롤해 제목이 띠를 벗어날 때는 콜백이 "무엇이 대신 활성인지"를
     * 알려주지 않아 하이라이트가 아래쪽 절에 붙박이고, 웹폰트가 늦게 로드돼
     * 레이아웃이 밀리면 관찰자는 다시 불리지 않아 초기 하이라이트가 어긋난
     * 채로 남는다(실제로 이 페이지에서 그랬다). 매번 현재 위치에서 다시
     * 계산하면 쌓아둘 상태 자체가 없어진다.
     */
    const activationLine = () => Math.max(HEADER_OFFSET, window.innerHeight * 0.3);

    const update = () => {
      const line = activationLine();
      let current: HTMLElement | null = null;
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top > line) break;
        current = heading;
      }
      setActive(current?.id ?? null);
    };

    /*
     * rAF로 묶지 않고 스크롤마다 바로 계산한다. 제목 몇 개의 rect를 읽는 정도라
     * 묶어서 아낄 게 없고, rAF는 탭이 화면에 없을 때 호출되지 않아 "동작하는지"를
     * 확인하기 어렵게 만든다. 진행률 바도 같은 방식으로 스크롤마다 갱신한다.
     */
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }
</script>
