---
import { categoryLabel } from '../lib/categories';
import { postDate } from '../lib/date';
import type { PostSummary } from '../lib/posts';
interface Props { posts: PostSummary[]; lang?: string; }
const { posts, lang = 'ko' } = Astro.props;
const en = lang === 'en';
---

{posts.length > 0 && (
  <section class="related-posts" aria-labelledby="related-title">
    <h2 id="related-title">{en ? 'Read next' : '이어서 읽기'}</h2>
    {posts.map((post) => (
      <a class="related-post" href={post.href}>
        <span>{en ? post.category : categoryLabel(post.category)} · <time datetime={post.pubDate.toISOString()} title={postDate(post.pubDate, post.dateSource, lang).title} aria-label={postDate(post.pubDate, post.dateSource, lang).ariaLabel}>{postDate(post.pubDate, post.dateSource, lang).text}</time></span>
        <strong>{post.title}</strong>
      </a>
    ))}
  </section>
)}

<style>
  .related-posts { border-top:1px solid var(--color-border);padding:30px 0; }
  h2 { margin:0 0 10px;font-size:15px;font-weight:600; }
  .related-post { display:block;padding:15px 0;border-bottom:1px solid var(--color-border); }
  .related-post span { display:block;font-size:12px;color:var(--color-ink-muted);margin-bottom:4px; }
  .related-post strong { font-size:16px;font-weight:500;line-height:1.7; }
  .related-post:hover strong { color:var(--color-accent); }
</style>
