---
import { render, type CollectionEntry } from 'astro:content';
import PostMeta from './PostMeta.astro';
import TableOfContents from './TableOfContents.astro';
import RelatedPosts from './RelatedPosts.astro';
import AdjacentNav from './AdjacentNav.astro';
import ReadingProgress from './ReadingProgress.astro';
import CodeCopyButton from './CodeCopyButton.astro';
import { loadPosts, toSummary } from '../lib/collection';
import { adjacentPosts, relatedPosts } from '../lib/posts';
import '../styles/post-content.css';

interface Props {
  entry: CollectionEntry<'posts'>;
  lang: string;
}
const { entry, lang } = Astro.props;
const { Content, headings } = await render(entry);
const post = toSummary(entry);
const pool = await loadPosts(lang);
const related = relatedPosts(post, pool);
const { prev, next } = adjacentPosts(post, pool);
---

<ReadingProgress />
<div class="post-page" id="post-top">
  <div class="reading-layout">
    <article class="post-article" data-pagefind-body>
      <PostMeta post={post} />
      <TableOfContents headings={headings} lang={lang} variant="mobile" />
      <div class="prose post-content">
        <Content />
      </div>
      {post.sourceUrl && <p class="post-source" data-pagefind-ignore><a href={post.sourceUrl}>{lang === 'en' ? 'Original post' : '기존 블로그 원문'} ↗</a></p>}
    </article>
    <TableOfContents headings={headings} lang={lang} variant="desktop" />
  </div>
  <div class="post-navigation" data-pagefind-ignore>
    <RelatedPosts posts={related} lang={lang} />
    <AdjacentNav prev={prev} next={next} lang={lang} />
  </div>
</div>
<CodeCopyButton lang={lang} />

<style>
  .post-source { margin: 32px 0 0; padding-top: 18px; border-top: 1px solid var(--color-border); font-size: 12px; color: var(--color-ink-muted); }
  .post-source a { text-decoration: underline; text-underline-offset: 3px; }
  .post-source a:hover { color: var(--color-accent); }
</style>
