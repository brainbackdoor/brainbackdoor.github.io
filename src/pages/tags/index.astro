---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadPosts } from '../../lib/collection';
import { collectTags } from '../../lib/posts';

const tags = collectTags(await loadPosts('ko'));
---

<BaseLayout title="태그 · 씨유" description="태그로 글을 모아 봅니다." active="archive" narrow>
  <h1 class="page-heading">태그</h1>

  <div class="flex flex-wrap gap-2.5 pb-18">
    {
      tags.map((t) => (
        <a
          href={`/tags/${encodeURIComponent(t.tag)}`}
          class="flex items-center gap-2 rounded-pill border border-ink/16 px-4 py-2 text-[13px] font-medium text-ink-subtle transition-colors hover:border-ink/32 hover:text-ink"
        >
          <span>#{t.tag}</span>
          <span class="font-mono text-[11px] text-ink-faint">{t.count}</span>
        </a>
      ))
    }
  </div>
</BaseLayout>
