---
const links = [
  { label: 'GitHub', href: 'https://github.com/brainbackdoor' },
  { label: 'LinkedIn', href: '#' },
  { label: 'Mail', href: 'mailto:brainbackdoor@gmail.com' },
];
const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10 bg-sunken">
  <div
    class="mx-auto flex max-w-container items-center justify-between px-8 py-7 text-[12.5px] text-ink-subtle"
  >
    <span>© 2016–{year} 이동규 · brainbackdoor</span>
    <span class="flex gap-5">
      {
        links.map((l) => (
          <a href={l.href} class="transition-colors hover:text-ink">
            {l.label}
          </a>
        ))
      }
      <a href="/rss.xml" class="font-semibold text-accent transition-opacity hover:opacity-75">
        RSS
      </a>
    </span>
  </div>
</footer>
