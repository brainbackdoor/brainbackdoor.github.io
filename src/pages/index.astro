---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadPosts } from '../lib/collection';
import { categoryLabel } from '../lib/categories';
import { postDate } from '../lib/date';
import { curricula } from '../data/curricula';
import { missions } from '../data/infra';
import TcpRecoveryFigure from '../components/figures/TcpRecoveryFigure';

const posts = await loadPosts('ko');
const featured = posts.find((post) => post.slug === 'tcp-error-recovery') ?? posts[0];
const recent = posts.filter((post) => post !== featured).slice(0, 5);
const curriculum = curricula.find((course) => course.id === 'infra');
---

<BaseLayout title="씨유 · brainbackdoor" description="이동규의 기술과 일상" active="home">
  <header class="home-intro"><h1>씨유의 기록</h1></header>
  {featured && (
    <section class="home-feature" aria-label="함께 읽을 글">
      <div>
        <span class="feature-category">{categoryLabel(featured.category)}</span>
        <h2><a href={featured.href}>{featured.title}</a></h2>
        <p>{featured.description}</p>
        <a class="feature-read" href={featured.href}>글 읽기 →</a>
      </div>
      {featured.slug === 'tcp-error-recovery' && (
        <div class="home-diagram">
          <TcpRecoveryFigure variant="preview" client:visible />
        </div>
      )}
    </section>
  )}

  <div class="home-content">
    <section aria-labelledby="recent-title">
      <div class="home-section-heading"><h2 id="recent-title">최근 기록</h2><a href="/posts">모든 글 보기 →</a></div>
      {recent.length ? (
        <ul class="home-posts">
          {recent.map((post) => (
            <li><a class="home-entry" href={post.href}>
              <div class="home-entry-meta">{categoryLabel(post.category)} <time datetime={post.pubDate.toISOString()} title={postDate(post.pubDate, post.dateSource).title} aria-label={postDate(post.pubDate, post.dateSource).ariaLabel}>{postDate(post.pubDate, post.dateSource).text}</time></div>
              <h3>{post.title}</h3><p>{post.description}</p>
            </a></li>
          ))}
        </ul>
      ) : <p class="home-empty">아직 다른 글이 없습니다.</p>}
    </section>
    {curriculum && (
      <aside class="home-curriculum" aria-labelledby="home-curriculum-title">
        <a class="curriculum-label" href="/curricula">커리큘럼</a>
        <h2 id="home-curriculum-title"><a href={curriculum.href}>{curriculum.title} →</a></h2>
        <ol class="curriculum-path">{missions[0].steps.map((step) => <li><a href={step.href}>{step.label}</a></li>)}</ol>
        <a class="curriculum-link" href={curriculum.href}>커리큘럼 살펴보기 →</a>
        <a class="catalog-link" href="/curricula">모든 커리큘럼</a>
      </aside>
    )}
  </div>
</BaseLayout>

<style>
  .home-intro { padding-bottom: 38px; }
  .home-intro h1 { margin: 0; font-size: 35px; font-weight: 600; line-height: 1.45; letter-spacing: -1.6px; }
  .home-feature { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .95fr); align-items: center; gap: 28px; padding: 28px 30px 26px; border-radius: 8px; background: var(--color-surface); }
  .feature-category { display: block; margin-bottom: 10px; color: var(--color-accent); font-size: 12px; font-weight: 600; }
  .home-feature h2 { max-width: 270px; margin: 0; font-size: 24px; font-weight: 600; letter-spacing: -.7px; line-height: 1.5; }
  .home-feature p { margin: 14px 0 0; color: var(--color-ink-muted); font-size: 13px; line-height: 1.9; }
  .feature-read { display: inline-block; margin-top: 18px; padding-bottom: 2px; border-bottom: 1px solid #9ebce8; color: var(--color-accent); font-size: 13px; font-weight: 600; }
  .home-diagram { display: block; min-width: 0; }
  .home-content { display: grid; grid-template-columns: minmax(0, 1fr) 200px; gap: 42px; margin-top: 43px; }
  .home-section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 4px; }
  .home-section-heading h2, .home-curriculum h2 { margin: 0; font-size: 16px; font-weight: 600; }
  .home-section-heading > a { flex-shrink: 0; color: var(--color-ink-muted); font-size: 11px; }
  .home-posts { list-style: none; margin: 0; padding: 0; }
  .home-entry { display: block; padding: 20px 0; border-bottom: 1px solid var(--color-border); }
  .home-entry-meta { display: flex; flex-wrap: wrap; gap: 10px; color: var(--color-ink-muted); font-size: 11px; }
  .home-entry h3 { margin: 5px 0; font-size: 18px; font-weight: 600; letter-spacing: -.35px; line-height: 1.6; }
  .home-entry p, .home-empty { margin: 0; color: var(--color-ink-muted); font-size: 13px; line-height: 1.9; }
  .home-entry:hover h3 { color: var(--color-accent); }
  .home-curriculum { padding-left: 24px; border-left: 1px solid var(--color-border); }
  .curriculum-label { display: block; margin-bottom: 9px; color: var(--color-accent); font-size: 11px; font-weight: 600; }
  .curriculum-path { list-style: none; margin: 22px 0 0; padding: 0; }
  .curriculum-path li { position: relative; margin-left: 4px; padding: 0 0 23px 21px; border-left: 1px solid #b3c9e8; font-size: 13px; }
  .curriculum-path li:last-child { padding-bottom: 0; border-color: transparent; }
  .curriculum-path li::before { content: ''; position: absolute; top: 7px; left: -5px; width: 8px; height: 8px; border: 2px solid var(--color-accent); border-radius: 50%; background: var(--color-canvas); }
  .curriculum-link { display: block; margin-top: 24px; color: var(--color-accent); font-size: 11px; font-weight: 600; }
  .catalog-link { display: inline-block; margin-top: 10px; border-bottom: 1px solid var(--color-border); color: var(--color-ink-muted); font-size: 11px; }
  @media (max-width: 850px) {
    .home-intro h1 { font-size: 30px; }
    .home-feature { grid-template-columns: 1fr; }
    .home-diagram { max-width: 320px; }
    .home-content { grid-template-columns: 1fr; }
    .home-curriculum { padding: 24px 0 0; border-left: 0; border-top: 1px solid var(--color-border); }
    .curriculum-path { display: flex; gap: 16px; }
    .curriculum-path li { flex: 1; padding-left: 14px; border-left: 0; }
  }
  @media (max-width: 600px) {
    .home-intro { padding: 0 0 28px; }
    .home-intro h1 { font-size: 28px; letter-spacing: -1.3px; }
    .home-feature { gap: 20px; padding: 24px; }
    .home-feature h2 { max-width: none; font-size: 23px; }
    .home-diagram { max-width: none; }
    .home-content { gap: 27px; margin-top: 31px; }
    .curriculum-path { display: block; }
    .curriculum-path li { padding-left: 21px; border-left: 1px solid #b3c9e8; }
    .curriculum-path li:last-child { border-color: transparent; }
  }
</style>
