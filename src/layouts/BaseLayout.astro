---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { NavKey } from '../lib/nav';
import type { AltLocale } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  /** 헤더에서 현재 위치를 표시할 nav 키 */
  active?: NavKey;
  /** 아카이브처럼 본문 폭이 900px인 페이지 */
  narrow?: boolean;
  /** 언어 전환 컨트롤을 띄울 때. 없으면 컨트롤이 안 나온다. */
  altLocale?: AltLocale;
  /** OG 이미지. 글은 대표 이미지를 넘긴다. 없으면 기본 브랜드 OG. */
  ogImage?: string;
}

const { title, description, active, narrow = false, altLocale, ogImage: ogImageProp } = Astro.props;
const lang = Astro.currentLocale ?? 'ko';
const canonical = new URL(Astro.url.pathname, Astro.site);

// 글이 대표 이미지를 넘기면 그걸, 아니면 기본 브랜드 OG(화이트 brainbackdoor).
const ogImage = ogImageProp
  ? new URL(ogImageProp, Astro.site).href
  : new URL('/og/default.png', Astro.site).href;

const person = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: '씨유 · brainbackdoor', url: Astro.site?.href },
    {
      '@type': 'Person',
      name: '이동규',
      alternateName: 'brainbackdoor',
      jobTitle: '소프트웨어 엔지니어',
      email: 'brainbackdoor@gmail.com',
      url: Astro.site?.href,
      sameAs: [
        'https://github.com/brainbackdoor',
        'https://www.linkedin.com/in/%EB%8F%99%EA%B7%9C-%EC%9D%B4-0606b415a/',
        'https://www.facebook.com/brainbackdoor',
        'https://www.instagram.com/dongguulee/',
      ],
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="씨유 · brainbackdoor" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#9a4b34" />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />

    <link rel="alternate" type="application/rss+xml" title={title} href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Sans+KR:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="flex min-h-screen flex-col">
    <Header active={active} altLocale={altLocale} />
    <main
      class:list={[
        'w-full flex-1 px-8',
        narrow ? 'max-w-container-narrow' : 'max-w-container',
        'mx-auto',
      ]}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
