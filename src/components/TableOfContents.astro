---
import type { MarkdownHeading } from 'astro';
interface Props {
  headings: MarkdownHeading[];
  lang?: string;
  variant?: 'mobile' | 'desktop';
}
const { headings, lang = 'ko', variant = 'desktop' } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2);
const title = lang === 'en' ? 'On this page' : '이 글의 내용';
---

{items.length > 0 && (variant === 'mobile' ? (
  <details class="post-mobile-toc" data-pagefind-ignore>
    <summary>{title}</summary>
    <nav aria-label={title}>
      <ol>{items.map((heading) => <li><a href={`#${heading.slug}`} data-post-toc={heading.slug}>{heading.text}</a></li>)}</ol>
    </nav>
  </details>
) : (
  <aside class="post-toc" data-pagefind-ignore>
    <nav aria-label={title}>
      <p>{title}</p>
      <ol>{items.map((heading) => <li><a href={`#${heading.slug}`} data-post-toc={heading.slug}>{heading.text}</a></li>)}</ol>
      <a class="to-top" href="#post-top">{lang === 'en' ? 'Back to top ↑' : '처음으로 ↑'}</a>
    </nav>
  </aside>
))}

<style>
  .post-toc { position:sticky;top:48px;padding-top:4px;font-size:12px;color:var(--color-ink-muted); }
  .post-toc p { font-size:12px;font-weight:600;color:var(--color-ink);margin:0 0 15px; }
  .post-toc ol { list-style:none;margin:0;padding:0;border-left:1px solid var(--color-border); }
  .post-toc a { display:block;padding:7px 0 7px 13px;line-height:1.8;margin-left:-1px;border-left:2px solid transparent;overflow-wrap:anywhere; }
  .post-toc a[aria-current='location'] { color:var(--color-accent);border-left-color:var(--color-accent); }
  .post-toc .to-top { display:inline-block;margin-top:23px;padding:0;font-size:11px;border:0; }
  .post-mobile-toc { display:none;margin:26px 0 29px;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);font-size:13px;color:var(--color-ink-muted); }
  .post-mobile-toc summary { padding:14px 0;cursor:pointer;color:var(--color-ink); }
  .post-mobile-toc ol { margin:0 0 17px;padding-left:20px;list-style:decimal; }
  .post-mobile-toc li { margin:8px 0; }
  .post-mobile-toc a { display:block;padding:3px 0; }
  .post-mobile-toc a[aria-current='location'], a:hover { color:var(--color-accent); }
  @media(max-width:1100px) { .post-toc{display:none}.post-mobile-toc{display:block} }
</style>

<script>
  const headings = [...document.querySelectorAll<HTMLElement>('.post-content h2[id]')];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-post-toc]')];
  const updatePostToc = () => {
    let current: string | undefined;
    for (const heading of headings) {
      if (heading.getBoundingClientRect().top > Math.max(80, window.innerHeight * 0.3)) break;
      current = heading.id;
    }
    for (const link of links) {
      if (link.dataset.postToc === current) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  };
  updatePostToc();
  window.addEventListener('scroll', updatePostToc, { passive: true });
  window.addEventListener('resize', updatePostToc, { passive: true });
  document.fonts.ready.then(updatePostToc);
  for (const link of document.querySelectorAll<HTMLAnchorElement>('.post-mobile-toc a')) {
    link.addEventListener('click', () => { const details = link.closest('details'); if (details) details.open = false; });
  }
</script>
