---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatTile from '../../components/StatTile.astro';
import MissionCard from '../../components/MissionCard.astro';
import TopicSection from '../../components/TopicSection.astro';
import { Button } from '@astryxdesign/core/Button';
import { stats, topics, missions, sections } from '../../data/infra';

const description =
  '만들고 부수며 인프라를 배웁니다. 인프라공방 수강생을 위한 미션 요구사항·힌트와 주제별 학습 자료를 한곳에 모았어요.';
---

<BaseLayout title="인프라 · 씨유" description={description} active="tech">
  <section class="pt-14 pb-9">
    <div
      class="mb-4 text-xs font-semibold tracking-[0.16em] text-ink-faint uppercase"
    >
      학습 대시보드
    </div>

    <div class="grid items-end gap-8 lg:grid-cols-[1fr_auto]">
      <div>
        <h1
          class="m-0 text-[30px] leading-[1.15] font-extrabold tracking-[-0.03em] sm:text-[44px] sm:leading-[1.1]"
        >
          인프라
        </h1>
        <p class="mt-4 max-w-[560px] text-[17px] leading-relaxed text-ink-muted">
          {description}
        </p>
      </div>
      <a
        href="https://www.inflearn.com/course/인프라-공방-서비스-만들기"
        class="shrink-0 self-start lg:self-end"
      >
        <Button label="인프런 강의 →" variant="primary" />
      </a>
    </div>

    <div class="mt-8 flex flex-wrap gap-3.5">
      {stats.map((s) => <StatTile value={s.value} label={s.label} />)}
    </div>
  </section>

  <div class="grid items-start gap-14 pb-18 lg:grid-cols-[200px_1fr]">
    <aside class="hidden lg:sticky lg:top-20 lg:block">
      <div
        class="mb-3.5 text-[11px] font-semibold tracking-[0.14em] text-ink-subtle uppercase"
      >
        주제
      </div>
      <nav class="flex flex-col gap-px border-l-2 border-ink/10">
        {
          topics.map((t) => (
            <a
              href={t.anchor}
              class="-ml-0.5 border-l-2 border-transparent py-[7px] pl-4 text-[13.5px] text-ink-subtle transition-all hover:border-accent hover:text-ink"
            >
              {t.label}
            </a>
          ))
        }
      </nav>
    </aside>

    <div class="min-w-0">
      <section id="mission" class="mb-13 scroll-mt-20">
        <h2 class="mb-2 text-2xl font-bold tracking-[-0.02em]">인프라공방 미션</h2>
        <p class="mt-0 mb-6 max-w-[640px] text-[15px] leading-relaxed text-ink-muted">
          현업과 비슷하게, 인프라를 구성해가며 필요한 지식을 학습하고 적용합니다. 각
          미션은 요구사항·저장소·단계별 가이드로 이루어져 있어요.
        </p>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
          {missions.map((m) => <MissionCard mission={m} />)}
        </div>
      </section>

      {sections.map((sec) => <TopicSection section={sec} />)}
    </div>
  </div>
</BaseLayout>
