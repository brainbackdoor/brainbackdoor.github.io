---
interface Props { lang?: string; }
const { lang = 'ko' } = Astro.props;
---
<span class="sr-only" id="code-copy-feedback" role="status" data-lang={lang}></span>

<script>
  const feedback = document.getElementById('code-copy-feedback');
  const en = feedback?.dataset.lang === 'en';
  for (const pre of document.querySelectorAll<HTMLPreElement>('.post-content pre')) {
    if (pre.parentElement?.classList.contains('code-block')) continue;
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    const toolbar = document.createElement('div');
    toolbar.className = 'code-toolbar';
    const label = document.createElement('span');
    label.textContent = pre.dataset.language ?? pre.querySelector('code')?.className.match(/language-([\w+-]+)/)?.[1] ?? (en ? 'Code' : '코드');
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy';
    button.textContent = en ? 'Copy' : '복사';
    button.setAttribute('aria-label', en ? `Copy ${label.textContent} code` : `${label.textContent} 코드 복사`);
    pre.tabIndex = 0;
    pre.setAttribute('aria-label', en ? `${label.textContent} code block` : `${label.textContent} 코드 블록`);
    pre.replaceWith(wrapper);
    toolbar.append(label, button);
    wrapper.append(toolbar, pre);

    let reset: ReturnType<typeof setTimeout>;
    button.addEventListener('click', async () => {
      const code = pre.querySelector('code');
      if (!code) return;
      clearTimeout(reset);
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        button.textContent = en ? 'Copied' : '복사됨';
        if (feedback) feedback.textContent = en ? 'Code copied.' : '코드를 복사했습니다.';
      } catch {
        const selection = window.getSelection();
        const range = document.createRange();
        range.selectNodeContents(code);
        selection?.removeAllRanges();
        selection?.addRange(range);
        button.textContent = en ? 'Selected' : '선택됨';
        if (feedback) feedback.textContent = en ? 'Code selected. Use the copy shortcut.' : '코드를 선택했습니다. 복사 단축키를 눌러 주세요.';
      }
      reset = setTimeout(() => { button.textContent = en ? 'Copy' : '복사'; if (feedback) feedback.textContent = ''; }, 1800);
    });
  }
  for (const table of document.querySelectorAll<HTMLTableElement>('.post-content table')) {
    table.tabIndex = 0;
    if (!table.getAttribute('aria-label') && !table.querySelector('caption')) table.setAttribute('aria-label', en ? 'Scrollable table' : '가로로 스크롤할 수 있는 표');
  }
</script>
