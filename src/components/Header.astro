---
import { NAV_ITEMS, type NavKey } from '../lib/nav';
import LangSwitch from './LangSwitch.astro';
import type { AltLocale } from '../lib/i18n';

interface Props {
  active?: NavKey;
  altLocale?: AltLocale;
}
const { active, altLocale } = Astro.props;
---

<header class="site-rail" data-pagefind-ignore>
  <a class="site-brand" href="/" aria-label="씨유 홈">
    <span class="site-brand-mark" aria-hidden="true">·</span><span>씨유</span>
  </a>
  <p class="site-signature">이동규의 기술과 일상</p>
  <nav class="site-nav" aria-label="주 메뉴">
    {NAV_ITEMS.map(item => (
      <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
  <div class="site-utilities">
    <a href="/search" class="site-search" aria-label="글 검색" aria-current={active === 'search' ? 'page' : undefined}>
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <span>글 검색</span>
    </a>
    {altLocale && <LangSwitch current={altLocale.current} altHref={altLocale.href} />}
  </div>
  <div class="site-rail-note">
    <a href="/about" aria-label="이동규 소개"><img src="/me.webp" alt="이동규" width="38" height="38" /></a>
    <a href="https://github.com/brainbackdoor" target="_blank" rel="noopener noreferrer">GitHub</a>
  </div>
</header>

<style>
  .site-rail{position:sticky;top:48px;height:calc(100vh - 96px);min-height:470px;display:flex;flex-direction:column;align-items:flex-start}
  .site-brand{display:flex;align-items:center;gap:10px;font-size:25px;font-weight:700;letter-spacing:-1px}
  .site-brand-mark{display:grid;place-items:center;width:28px;height:34px;border:2px solid var(--color-accent);border-radius:18px 18px 18px 3px;transform:rotate(-12deg);color:var(--color-accent);font-size:18px}
  .site-signature{font-size:12px;color:var(--color-ink-muted);margin-top:10px}
  .site-nav{display:flex;flex-direction:column;gap:15px;margin-top:50px;font-size:14px;width:100%}
  .site-nav a{padding-left:14px;border-left:2px solid transparent}
  .site-nav a:hover,.site-utilities a:hover{color:var(--color-accent)}
  .site-nav a[aria-current]{border-color:var(--color-accent);color:var(--color-accent);font-weight:600}
  .site-utilities{display:flex;flex-direction:column;gap:18px;padding-left:16px;margin-top:30px;font-size:12px;color:var(--color-ink-muted)}
  .site-search{display:flex;align-items:center;gap:7px}
  .site-search[aria-current]{color:var(--color-accent);font-weight:600}
  .site-rail-note{margin-top:auto;padding-top:48px;font-size:12px;color:var(--color-accent)}
  .site-rail-note img{display:block;width:38px;height:38px;object-fit:cover;border-radius:50%;margin-bottom:12px}
  @media(max-width:850px){.site-rail{top:32px}}
  @media(max-width:600px){
    .site-rail{position:relative;top:auto;display:block;height:auto;min-height:0;padding-top:22px}
    .site-brand{font-size:22px;width:fit-content}.site-brand-mark{width:24px;height:29px}
    .site-signature,.site-rail-note{display:none}
    .site-nav{flex-direction:row;gap:22px;margin-top:24px;border-bottom:1px solid var(--color-border);font-size:13px}
    .site-nav a{padding:0 0 12px;border-left:0;white-space:nowrap;border-bottom:2px solid transparent}
    .site-nav a[aria-current]{border-bottom-color:var(--color-accent)}
    .site-utilities{position:absolute;top:24px;right:0;flex-direction:row;align-items:center;gap:14px;margin:0;padding:0;font-size:11px}
  }
  @media(max-width:360px){.site-nav{gap:17px;font-size:12px}.site-utilities{gap:10px}.site-search span{display:none}}
</style>
